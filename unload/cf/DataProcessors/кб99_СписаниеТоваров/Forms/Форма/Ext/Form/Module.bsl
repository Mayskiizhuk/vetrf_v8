
#Область ОбработчикиСобытий

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Период.ДатаНачала = НачалоМесяца(ТекущаяДатаСеанса());
	Период.ДатаОкончания = ТекущаяДатаСеанса();
	
	ОбновитьЗаПериодНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОбновитьЗаПериод(Команда)
	
	Если Не ЗначениеЗаполнено(Период) Тогда
		кб99_ВСД.СообщитьПользователю(НСтр("ru = 'Не заполнено поле'"),, "Период", Период);
		Возврат;
	КонецЕсли;
	
	ОбновитьЗаПериодНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура Списать(Команда)
	ЗаполнитьТаблицуПартийНаСервере();
	//ОбновитьЗаПериодНаСервере(); // Очищает условное оформление
КонецПроцедуры

&НаКлиенте
Процедура СнятьОтметкиСДокументов(Команда)
	
	Для Каждого стр Из Список Цикл
		стр.Отметка = Ложь;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВсеДокументы(Команда)
	УстановитьФлажкиНаВсеДокументы();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ОбновитьЗаПериодНаСервере()
	ЗаполнитьСтрокиТЧДокументамиРеализаций(Период.ДатаНачала, Период.ДатаОкончания);
	УстановитьФлажкиНаВсеДокументы();
	Элементы.Список.Обновить();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСтрокиТЧДокументамиРеализаций(ДатаНачала, ДатаОкончания);
	
	Список.Очистить();
	
	Запрос = Новый Запрос;
	ТекстЗапроса = 
		"ВЫБРАТЬ
		|	РеализацияТоваровУслуг.Ссылка КАК ДокументРеализации
		|ПОМЕСТИТЬ ВТ
		|ИЗ
		|	Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Партнеры КАК Партнеры
		|		ПО РеализацияТоваровУслуг.Партнер = Партнеры.Ссылка
		|ГДЕ
		|	РеализацияТоваровУслуг.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	%ВСД_не_Выписываем%
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВЫРАЗИТЬ(ВСД2_ИнвентаризацияДокументыОснования.ДокументОснования.Ссылка КАК Документ.РеализацияТоваровУслуг).Ссылка КАК ДокументОснования,
		|	ВСД2_ИнвентаризацияДокументыОснования.Ссылка КАК ДокументИнвентаризации
		|ПОМЕСТИТЬ ВТ2
		|ИЗ
		|	Документ.ВСД2_Инвентаризация.ДокументыОснования КАК ВСД2_ИнвентаризацияДокументыОснования
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ.ДокументРеализации КАК ДокументРеализации,
		|	ВТ2.ДокументИнвентаризации КАК ДокументИнвентаризации
		|ИЗ
		|	ВТ КАК ВТ
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ2 КАК ВТ2
		|		ПО ВТ.ДокументРеализации = ВТ2.ДокументОснования";
		
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);
	
	Если ЕстьРеквизитОбъекта("ВСД_не_Выписываем", Метаданные.Справочники.Партнеры) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "%ВСД_не_Выписываем%", "И Партнеры.ВСД_не_Выписываем");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "%ВСД_не_Выписываем%", "");
	КонецЕсли;
	
	Запрос.Текст = ТекстЗапроса;
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	Список.Загрузить(РезультатЗапроса.Выгрузить());
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуПартийНаСервере()
	
	Организация = кб99_ВСД_Параметры.ПолучитьОрганизациюПоУмолчанию();
	
	// Используем если переопределили
	//Организация = кб99_ВСД_Переопределения.ПолучитьОрганизациюПоУмолчанию();
	
	ПараметрыОрганизации = кб99_ВСД.ЗагрузитьПараметры(Организация);
	
	// Подготовка требуемых партий из отгрузок
	ТаблицаОтгрузок = Список.Выгрузить();
	РезультатПодготовки = ПодготовитьТребуемыеПартии(
		ТаблицаОтгрузок,
		ПараметрыОрганизации
	);
	
	ТребуемыеПартии = РезультатПодготовки.ТаблицаПартий;
	ПолеСортировкиПокупателя = РезультатПодготовки.ПолеСортировкиПокупателя;
	ЗнакСортировкиПокупателя = РезультатПодготовки.ЗнакСортировкиПокупателя;
	
	Если ТребуемыеПартии.Количество() = 0 Тогда
		кб99_ВСД.СообщитьИнфо("Нет документов к созданию списания ->");
		Возврат;
	КонецЕсли;
	
	Отправитель_ХозСубъект = ПараметрыОрганизации.Отправитель_ХозСубъект;
	Отправитель_Площадка = ПараметрыОрганизации.Отправитель_Площадка;
	
	// Поиск с использованием запроса
	//Отправитель_ХозСубъект = ПолучитьХозСубъекта();
	//Отправитель_Площадка = ПолучитьПлощадку(Отправитель_ХозСубъект);
	
	// Получение актуальных партий
	АктуальныеПартии = кб99_ВСД.ПолучитьАктуальныеПартии(
		ПараметрыОрганизации,
		ТребуемыеПартии.ВыгрузитьКолонку("ВСД_Продукция_Элемент"),
		Отправитель_Площадка,
		Отправитель_ХозСубъект,
		ПолеСортировкиПокупателя,
		ЗнакСортировкиПокупателя,
		ТребуемыеПартии.ВыгрузитьКолонку("Номенклатура")
	);
	
	Если НЕ (ТипЗнч(АктуальныеПартии) = Тип("ТаблицаЗначений")) И НЕ Объект.ПарамЗаполнятьТранзакциюПриОтсутствииПартий Тогда
		кб99_ВСД.СообщитьИнфо("Нет актуальных партий для создания Документов ");
		Возврат;
	КонецЕсли;
	
	// Уменьшаем актуальные партии на уже распределенные
	//УменьшитьАктуальныеПартииНаРаспределенные(АктуальныеПартии);
	
	// Распределение партий
	РаспределенныеПартии = кб99_ВСД_УправлениеФормой.РаспределитьПартииПоОстаткам(
		ТребуемыеПартии,
		АктуальныеПартии,
		ПараметрыОрганизации
	);
	
	РаспределенныеПартии.Свернуть(
		"ВидПродукции,
		|Документ,
		//|ИдентификаторСтроки,
		|Номенклатура,
		|Партия,
		|ПолеСортировки,
		|Продукция_Элемент,
		|Остаток,
		|ТермическиеУсловияПеревозки",
		"Количество,
		//|Остаток,
		|КоличествоСписания");
	
	СоздатьДокументИнвентаризации(РаспределенныеПартии, Организация, Отправитель_ХозСубъект, Отправитель_Площадка);
	
КонецПроцедуры

&НаСервере
Функция ПодготовитьТребуемыеПартии(ТаблицаОтгрузок, ПараметрыОрганизации)
	
	ВремПартии = Новый ТаблицаЗначений;
	ВремПартии.Колонки.Добавить("Номенклатура");
	ВремПартии.Колонки.Добавить("ВСД_Продукция_Элемент");
	ВремПартии.Колонки.Добавить("КоличествоСписания");
	ВремПартии.Колонки.Добавить("СерияНоменклатуры");
	ВремПартии.Колонки.Добавить("Документ");
	ВремПартии.Колонки.Добавить("ТермУсловияПеревозки");
	ВремПартии.Колонки.Добавить("Контрагент");
	ВремПартии.Колонки.Добавить("ВидПродукции");
	ВремПартии.Колонки.Добавить("ИдентификаторСтроки");
	
	ИтоговаяТаблицаТоваров = Новый ТаблицаЗначений;
	ИтоговаяТаблицаТоваров.Колонки.Добавить("ВидПродукции");
	ИтоговаяТаблицаТоваров.Колонки.Добавить("Документ");
	ИтоговаяТаблицаТоваров.Колонки.Добавить("ИдентификаторСтроки");
	ИтоговаяТаблицаТоваров.Колонки.Добавить("Количество");
	ИтоговаяТаблицаТоваров.Колонки.Добавить("Контрагент");
	ИтоговаяТаблицаТоваров.Колонки.Добавить("Коэффициент");
	ИтоговаяТаблицаТоваров.Колонки.Добавить("Номенклатура");
	ИтоговаяТаблицаТоваров.Колонки.Добавить("Продукция_Элемент");
	ИтоговаяТаблицаТоваров.Колонки.Добавить("РезультатыИсследований");
	ИтоговаяТаблицаТоваров.Колонки.Добавить("СерияНоменклатуры");
	ИтоговаяТаблицаТоваров.Колонки.Добавить("ТермУсловияПеревозки");
	ИтоговаяТаблицаТоваров.Колонки.Добавить("Упаковки");
	
	ПолеСортировкиПокупателя = Неопределено;
	ЗнакСортировкиПокупателя = Неопределено;
	
	Для Каждого СтрОтгрузки Из ТаблицаОтгрузок Цикл
		
		Если НЕ СтрОтгрузки.Отметка Тогда
			Продолжить;
		КонецЕсли;
		
		// Выгружаем товары из документа
		ТаблицаТоваров = кб99_ВСД_ЗаполнениеДокументов.ВыгрузитьТЧ(СтрОтгрузки.ДокументРеализации, ПараметрыОрганизации);
		Если ТаблицаТоваров.Колонки.Найти("Документ") = Неопределено Тогда
			ТаблицаТоваров.Колонки.Добавить("Документ");
		КонецЕсли;
		
		Для Каждого Стр Из ТаблицаТоваров Цикл
			Стр.Документ = СтрОтгрузки.ДокументРеализации;
		КонецЦикла;
		
		ДополнитьТаблицу(ТаблицаТоваров, ИтоговаяТаблицаТоваров);
		
	КонецЦикла;
	
	ИтоговаяТаблицаТоваров.Свернуть(
		"ВидПродукции,
		|ИдентификаторСтроки,
		|Контрагент,
		|Номенклатура,
		|Документ,
		|Продукция_Элемент,
		|РезультатыИсследований,
		|СерияНоменклатуры,
		|ТермУсловияПеревозки,
		|Упаковки",
		"Количество,
		|Коэффициент");
	
	Для Каждого СтрокаТоваров Из ИтоговаяТаблицаТоваров Цикл
		СтрокаПартий = ВремПартии.Добавить();
		СтрокаПартий.Номенклатура = СтрокаТоваров.Номенклатура;
		СтрокаПартий.ВСД_Продукция_Элемент = СтрокаТоваров.Продукция_Элемент;
		СтрокаПартий.КоличествоСписания = СтрокаТоваров.Количество;
		СтрокаПартий.СерияНоменклатуры = СтрокаТоваров.СерияНоменклатуры;
		СтрокаПартий.Документ = СтрокаТоваров.Документ;
		//СтрокаПартий.Контрагент = СтрОтгрузки.Контрагент;
		СтрокаПартий.ТермУсловияПеревозки = СтрокаТоваров.ТермУсловияПеревозки;
		СтрокаПартий.ВидПродукции = СтрокаТоваров.ВидПродукции;
		СтрокаПартий.ИдентификаторСтроки = СтрокаТоваров.ИдентификаторСтроки;
	КонецЦикла;
	
	ВремПартии.Свернуть(
		"ВСД_Продукция_Элемент,
		|СерияНоменклатуры,
		|Номенклатура,
		|Документ,
		|ТермУсловияПеревозки,
		|Контрагент,
		|ВидПродукции,
		|ИдентификаторСтроки",
		"КоличествоСписания");
	ВремПартии.Сортировать("ВСД_Продукция_Элемент");
	
	Результат = Новый Структура;
	Результат.Вставить("ТаблицаПартий", ВремПартии);
	Результат.Вставить("ПолеСортировкиПокупателя", ПолеСортировкиПокупателя);
	Результат.Вставить("ЗнакСортировкиПокупателя", ЗнакСортировкиПокупателя);
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПолучитьХозСубъекта()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВСД_ХозСубъект.Ссылка
		|ИЗ
		|	Справочник.ВСД_ХозСубъект КАК ВСД_ХозСубъект
		|ГДЕ
		|	ВСД_ХозСубъект.GUID = ""b26e9fef-560b-452f-8b53-d3d6b0322349""";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция ПолучитьПлощадку(ХозСубъект)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВСД_Площадка.Ссылка
		|ИЗ
		|	Справочник.ВСД_Площадка КАК ВСД_Площадка
		|ГДЕ
		|	ВСД_Площадка.ХозСубъект = &ХозСубъект";
	Запрос.УстановитьПараметр("ХозСубъект", ХозСубъект);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
КонецФункции

&НаСервере
Процедура СоздатьДокументИнвентаризации(РаспределенныеПартии, Организация, Отправитель_ХозСубъект, Отправитель_Площадка)
	
	Док = Документы.ВСД2_Инвентаризация.СоздатьДокумент();
	
	ПараметрыОрганизации = кб99_ВСД.ЗагрузитьПараметры(Организация);
	
	Док.Организация = Организация;
	
	Док.Владелец_ХозСубъект = Отправитель_ХозСубъект;
	Док.Владелец_Площадка   = Отправитель_Площадка;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЕСТЬNULL(РаспределенныеПартии.ВидПродукции, ЗНАЧЕНИЕ(Справочник.ВСД_ВидПродукции.ПустаяСсылка)) КАК ВидПродукции,
		|	ЕСТЬNULL(РаспределенныеПартии.Документ, ЗНАЧЕНИЕ(Документ.РеализацияТоваровУслуг.ПустаяСсылка)) КАК Документ,
		|	ЕСТЬNULL(РаспределенныеПартии.Количество, 0) КАК Количество,
		|	ЕСТЬNULL(РаспределенныеПартии.КоличествоСписания, 0) КАК КоличествоСписания,
		|	ЕСТЬNULL(РаспределенныеПартии.Номенклатура, ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)) КАК Номенклатура,
		|	ЕСТЬNULL(РаспределенныеПартии.Остаток, 0) КАК Остаток,
		|	ЕСТЬNULL(РаспределенныеПартии.Партия, ЗНАЧЕНИЕ(Справочник.ВСД_Партия.ПустаяСсылка)) КАК Партия,
		|	ЕСТЬNULL(РаспределенныеПартии.Продукция_Элемент, ЗНАЧЕНИЕ(Справочник.ВСД_Продукция_Элемент.ПустаяСсылка)) КАК Продукция_Элемент,
		|	ЕСТЬNULL(РаспределенныеПартии.ТермическиеУсловияПеревозки, ЗНАЧЕНИЕ(Перечисление.кб99_ТермическиеУсловияПеревозки.ПустаяСсылка)) КАК ТермическиеУсловияПеревозки
		|ПОМЕСТИТЬ втПартии
		|ИЗ
		|	&РаспределенныеПартии КАК РаспределенныеПартии
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	втПартии.ВидПродукции КАК ВидПродукции,
		|	втПартии.Документ КАК Документ,
		|	втПартии.Количество КАК Количество,
		|	втПартии.КоличествоСписания КАК КоличествоСписания,
		|	втПартии.Номенклатура КАК Номенклатура,
		|	втПартии.Остаток КАК Остаток,
		|	втПартии.Партия КАК Партия,
		|	втПартии.Продукция_Элемент КАК Продукция_Элемент,
		|	втПартии.ТермическиеУсловияПеревозки КАК ТермическиеУсловияПеревозки
		|ИЗ
		|	втПартии КАК втПартии
		|ИТОГИ
		|	МАКСИМУМ(Остаток)
		|ПО
		|	Партия";
	Запрос.УстановитьПараметр("РаспределенныеПартии", РаспределенныеПартии);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока Выборка.Следующий() Цикл
		
		КоличествоОстаток = Выборка.Остаток;
		
		НоваяСтрока = Док.Продукция.Добавить();
		
		ВыборкаДетальныеЗаписи = Выборка.Выбрать();
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			Если ВыборкаДетальныеЗаписи.Партия = Неопределено Тогда
				
				НоваяСтрока.Продукция_Элемент = ВыборкаДетальныеЗаписи.Продукция_Элемент;
				кб99_ВСД.СообщитьПользователю(СтрШаблон(НСтр("ru = 'На остатках партии продукции элемента [%1] не хватает количество списания [%2] для документа [%3]'"),
					ВыборкаДетальныеЗаписи.Продукция_Элемент, ВыборкаДетальныеЗаписи.КоличествоСписания, ВыборкаДетальныеЗаписи.Документ));
					
				Если КоличествоОстаток = Неопределено Тогда
					КоличествоОстаток = 0;
				КонецЕсли;
				
				ОтборСтрок = Новый Структура;
				ОтборСтрок.Вставить("ДокументРеализации", ВыборкаДетальныеЗаписи.Документ);
				
				СписокТЗ = РеквизитФормыВЗначение("Список");
				
				НайденныеСтрокиВТЧСписок = СписокТЗ.НайтиСтроки(ОтборСтрок);
				
				Если НайденныеСтрокиВТЧСписок.Количество() = 0 Тогда
					Продолжить;
				КонецЕсли;
				
				НайденнаяСтрока = НайденныеСтрокиВТЧСписок[0];
				Если ЗначениеЗаполнено(НайденнаяСтрока) Тогда
					НайденнаяСтрока.УстановитьЦвет = Истина;
				КонецЕсли;
				
				ЗначениеВРеквизитФормы(СписокТЗ, "Список");
				
				//Для Каждого стр Из Список Цикл
				//	Если (стр.ДокументРеализации = ВыборкаДетальныеЗаписи.Документ) И стр.УстановитьЦвет = Ложь Тогда
				//		стр.УстановитьЦвет = Истина;
				//		Прервать;
				//	КонецЕсли;
				//КонецЦикла;
				
			КонецЕсли;
			
			Разница = КоличествоОстаток - ВыборкаДетальныеЗаписи.КоличествоСписания;
			
			НоваяСтрока.КлючСтроки = Новый УникальныйИдентификатор();
			
			НоваяСтрока.Продукция_Элемент = ВыборкаДетальныеЗаписи.Продукция_Элемент;
			НоваяСтрока.Количество        = Разница;
			
			Если ВыборкаДетальныеЗаписи.Партия <> Неопределено Тогда
				
				НоваяСтрока.Партия           = ВыборкаДетальныеЗаписи.Партия;
				НоваяСтрока.ЕдиницаИзмерения = ВыборкаДетальныеЗаписи.Партия.ЕдиницаИзмерения;
				
				ДатаИзготовления1 = СтрокаВДату(ВыборкаДетальныеЗаписи.Партия.ДатаИзготовления1);
				ДатаСрокГодности1 = СтрокаВДату(ВыборкаДетальныеЗаписи.Партия.ДатаСрокГодности1);
				
				НоваяСтрока.ДатаИзготовления1 = ДатаИзготовления1;
				НоваяСтрока.ДатаСрокГодности1 = ДатаСрокГодности1;
				
			КонецЕсли;
			
			НоваяСтрока.НаименованиеПродукции = ВыборкаДетальныеЗаписи.Продукция_Элемент.Наименование;
			
			НоваяСтрока.Производитель_площадка = ВыборкаДетальныеЗаписи.Продукция_Элемент.Площадка;
			НоваяСтрока.Производитель_Страна   = ?(ЗначениеЗаполнено(НоваяСтрока.Производитель_площадка.Страна),
				НоваяСтрока.Производитель_площадка.Страна,
				ПараметрыОрганизации["Страна"]);
			
			НоваяСтрока.Продукция    = ВыборкаДетальныеЗаписи.Продукция_Элемент.Продукция;
			НоваяСтрока.ВидПродукции = ВыборкаДетальныеЗаписи.Продукция_Элемент.ВидПродукции;
			
			КоличествоОстаток = Разница;
			
			ОтборСтрок = Новый Структура;
			ОтборСтрок.Вставить("ДокументОснования", ВыборкаДетальныеЗаписи.Документ);
			
			НайденныеСтрокиВТЧДокументыОснования = Док.ДокументыОснования.НайтиСтроки(ОтборСтрок);
				
			Если НайденныеСтрокиВТЧДокументыОснования.Количество() > 0 Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрокаТЧ = Док.ДокументыОснования.Добавить();
			НоваяСтрокаТЧ.ДокументОснования = ВыборкаДетальныеЗаписи.Документ;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Док.Дата = ТекущаяДатаСеанса();
	
	Попытка
		Док.Записать();
	Исключение
		кб99_ВСД.СообщитьИнфо(ОписаниеОшибки());
	КонецПопытки;
	
	Элементы.Список.Обновить();
	
КонецПроцедуры

&НаСервере
Функция СтрокаВДату(СтрокаДаты)
	
	Попытка
		// Разбиваем строку на компоненты по разделителю "-"
		МассивКомпонентов = СтрРазделить(СтрокаДаты, "-", Ложь);
		
		// Проверяем количество компонентов
		Если МассивКомпонентов.Количество() <> 3 Тогда
			ВызватьИсключение "Некорректный формат даты. Требуется формат ГГГГ-ММ-ДД";
		КонецЕсли;
		
		// Преобразуем компоненты в числа
		Год   = Число(МассивКомпонентов[0]);
		Месяц = Число(МассивКомпонентов[1]);
		День  = Число(МассивКомпонентов[2]);
		
		// Создаем дату (время устанавливается в 00:00:00)
		Возврат Дата(Год, Месяц, День);
		
	Исключение
		// Формируем детальное сообщение об ошибке
		ОписаниеОшибки = СтрШаблон("Ошибка преобразования строки '%1' в дату.", СтрокаДаты) + Символы.ПС + ОписаниеОшибки();
		кб99_ВСД.СообщитьИнфо(ОписаниеОшибки);
	КонецПопытки;
	
КонецФункции

&НаКлиенте
Процедура ПериодПриИзменении(Элемент)
	ОбновитьЗаПериодНаСервере();
КонецПроцедуры

&НаСервере
Процедура УстановитьФлажкиНаВсеДокументы()
	
	Для Каждого стр Из Список Цикл
		Если Не ЗначениеЗаполнено(стр.ДокументИнвентаризации) Тогда
			стр.Отметка = Истина;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область БСП

// Дополняет таблицу значений - приемник данными из таблицы значений - источника.
// Типы ТаблицаЗначений, ДеревоЗначений, ТабличнаяЧасть не доступны на клиенте.
//
// Параметры:
//  ТаблицаИсточник - ТаблицаЗначений,
//                    ДеревоЗначений,
//                    ТабличнаяЧасть,
//                    ДанныеФормыКоллекция - таблица, из которой будут браться строки для заполнения;
//  ТаблицаПриемник - ТаблицаЗначений,
//                    ДеревоЗначений,
//                    ТабличнаяЧасть,
//                    ДанныеФормыКоллекция - таблица, в которую будут добавлены строки из таблицы-источника.
//
&НаСервереБезКонтекста
Процедура ДополнитьТаблицу(ТаблицаИсточник, ТаблицаПриемник)
	
	Для Каждого СтрокаТаблицыИсточник Из ТаблицаИсточник Цикл
		ЗаполнитьЗначенияСвойств(ТаблицаПриемник.Добавить(), СтрокаТаблицыИсточник);
	КонецЦикла;
	
КонецПроцедуры

// Позволяет определить, есть ли среди реквизитов объекта реквизит с переданным именем.
//
// Параметры:
//  ИмяРеквизита - Строка - имя реквизита;
//  МетаданныеОбъекта - ОбъектМетаданных - объект, в котором требуется проверить наличие реквизита.
//
// Возвращаемое значение:
//  Булево - Истина, если есть.
//
Функция ЕстьРеквизитОбъекта(ИмяРеквизита, МетаданныеОбъекта) Экспорт
	Возврат НЕ (МетаданныеОбъекта.Реквизиты.Найти(ИмяРеквизита) = Неопределено);
КонецФункции
	
#КонецОбласти






